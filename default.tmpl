# screen pixels (real, hardware)
WIDTH=1024  # {{cookiecutter.width}}
HEIGHT=600  # {{cookiecutter.height}}

# reference/idealized screen pixels
REFX = 1980
REFY = 1080

def u(real, ref, v):
    if abs(v)<0.9999999:
        result = int( (float(real)/100.0) * (v*1000))
        if v<0:
            return real-result
        return result
    return int( (real/ref) * v )

def ux(*argv):
    global WIDTH, REFX
    acc = 0
    for v in argv:
        acc += u(WIDTH, REFX, v)
    return acc

def uy(*argv):
    global HEIGHT, REFY
    acc = 0
    for v in argv:
        acc += u(HEIGHT, REFY, v)
    return acc




# do not rename
async def custom_site():

    import sys
    import asyncio
    import platform
    import json
    from pathlib import Path



    import embed


    platform.document.body.style.background = "#7f7f7f"

    import pygame

    def compose():
        pygame.display.update()

    pygame.init()
    pygame.font.init()

    screen = pygame.display.set_mode([ux(.100),uy(.100)], pygame.SRCALPHA, 32)
    screen.set_colorkey( (0,0,0,0), pygame.RLEACCEL )
    screen.fill( (0,0,0,0) )

    compose()

    platform.window.transfer.hidden = true
    platform.window.canvas.style.visibility = "visible"



    apk = "sengoku-tactics.apk"

    bundle = "sengoku-tactics"

    # the C or js loader could do that but be explicit.
    appdir = Path(f"/data/data/{bundle}") # /data/data/sengoku-tactics
    appdir.mkdir()


    # mount apk

    cfg = {
        "io": "url",
        "type":"mount",
        "mount" : {
            "point" : appdir.as_posix(),
            "path" : "/",
        },
        "path" : f"/ => {appdir.as_posix()}",
    }


    track = platform.window.MM.prepare(apk, json.dumps(cfg))

    marginx = ux(.020) # 20%
    marginy = uy(.045) # 45%


    _dbfont = pygame.font.Font(None, 20)

    def pg_bar(pos):
        nonlocal marginx, marginy
        total = track.len or 10
        slot = ux(.060) / total
        pygame.draw.rect(screen, (10,10,10), (marginx-ux(10), marginy-uy(10), (total*slot)+ux(20), uy(110)))
        pygame.draw.rect(screen, (0,255,0),  (marginx, marginy, pos*slot, uy(90)))
        # status line below bar so user can see what's happening
        _status = f"APK: {int(track.pos)}/{int(track.len) if track.len else '?'}  ready={bool(track.ready)}"
        screen.blit(_dbfont.render(_status, True, (180,180,180)), (marginx, marginy + uy(100)))

    # Wait for zip mount + overlayfs to complete.
    # We use TWO conditions so either one can unblock us:
    #   1. track.ready becomes True (normal completion)
    #   2. main_path actually exists in the VFS (mount succeeded)
    #   3. 60-second wall-clock hard limit (prevents infinite hang)
    import time as _time
    import os
    _t0 = _time.monotonic()
    _post_dl = 0
    _loop_iters = 0
    _ready_at_start = bool(track.ready)   # diagnostic: was ready immediately?
    main_path = appdir / "assets" / "main.py"

    while True:
        _loop_iters += 1
        _elapsed = _time.monotonic() - _t0

        # Condition 1: file is actually there
        if main_path.exists():
            print(f"main.py found after {_elapsed:.1f}s ({_loop_iters} iters)")
            break

        # Condition 2: track says ready (and we've waited at least 0.5 s)
        if track.ready and _elapsed > 0.5:
            print(f"track.ready after {_elapsed:.1f}s, file not yet visible — waiting")

        # Condition 3: timeout
        if _elapsed > 90:
            print(f"TIMEOUT after {_elapsed:.0f}s: track.ready={bool(track.ready)} "
                  f"pos={track.pos} len={track.len} ready_at_start={_ready_at_start}")
            break

        pg_bar(track.pos)
        compose()
        await asyncio.sleep(.1)

    # fill bar to 100%
    pg_bar(track.len)
    compose()
    await asyncio.sleep(0)

    _assets = str(appdir / "assets")

    if _assets not in sys.path:
        sys.path.insert(0, _assets)
    try:
        os.chdir(_assets)
    except Exception as _cd_err:
        print("chdir failed:", _cd_err)

    # Show status on canvas
    _lf = pygame.font.Font(None, 24)
    screen.blit(_lf.render("Launching game...", True, (200, 200, 200)),
                (marginx, marginy + uy(100)))
    pygame.display.update()
    await asyncio.sleep(0)

    screen.fill((0, 0, 0, 0))
    pygame.display.update()
    await asyncio.sleep(0)

    _ns = {"__name__": "__main__", "__file__": str(main_path)}

    # Collect diagnostics to show alongside any error
    try:
        _dd = os.listdir("/data/data") if os.path.isdir("/data/data") else []
    except Exception:
        _dd = ["<error listing /data/data>"]
    try:
        _ad = os.listdir(str(appdir)) if os.path.isdir(str(appdir)) else []
    except Exception:
        _ad = ["<error listing appdir>"]

    _diag = (f"track.ready={bool(track.ready)} pos={track.pos} len={track.len} "
             f"ready_at_start={_ready_at_start} iters={_loop_iters}\n"
             f"/data/data/={_dd}\n"
             f"appdir={_ad}")

    try:
        print("Reading:", str(main_path))
        print("Diag:", _diag)
        _code = open(str(main_path)).read()
        print("Read OK len=", len(_code))
        exec(_code, _ns)
        print("exec OK, awaiting main()")
        await _ns["main"]()
    except Exception as _e:
        import traceback
        _tb = traceback.format_exc()
        print("GAME LAUNCH ERROR:\n", _tb)
        screen.fill((40, 0, 0))
        _ef = pygame.font.Font(None, 18)
        _ey = 10
        for _line in (_diag + "\n" + _tb).splitlines():
            screen.blit(_ef.render(_line[:110], True, (255, 120, 120)), (10, _ey))
            _ey += 20
            if _ey > screen.get_height() - 10:
                break
        pygame.display.update()
        while True:
            await asyncio.sleep(1)



import asyncio

asyncio.run( custom_site() )


